# upwork-job-radar - environment
#
# Copy to .env and fill in. NEVER commit the filled-in copy; .gitignore already
# excludes it. Every value below is a default that works, except the two
# credentials and the Slack channel id.
#
# In n8n these are set under Settings -> Environment variables (or in the
# container's env). The Load Config node reads them; nothing is hardcoded in a
# node and nothing is written into a prompt.

# ---------------------------------------------------------------------------
# Credentials
# ---------------------------------------------------------------------------

# Upwork OAuth2 app, from the Upwork developer portal. Used to create the
# "Upwork OAuth2 API" credential inside n8n - the workflow itself only ever
# references the credential, never these values.
UPWORK_CLIENT_ID=your-upwork-app-client-id
UPWORK_CLIENT_SECRET=your-upwork-app-client-secret

# Slack bot token with chat:write, and the channel to post into.
# The bot must be invited to the channel.
SLACK_BOT_TOKEN=xoxb-your-slack-bot-token
SLACK_CHANNEL_ID=C0000000000

# ---------------------------------------------------------------------------
# What to search for
# ---------------------------------------------------------------------------

# Upwork search expression. Change this first - the default is a placeholder.
RADAR_SEARCH_QUERY=n8n OR automation OR "api integration"

# Jobs per poll. The step cap still applies on top of this.
RADAR_PAGE_SIZE=50

# ---------------------------------------------------------------------------
# Scoring
# ---------------------------------------------------------------------------

# Alert at or above this score (0-100).
RADAR_ALERT_THRESHOLD=70

# Optional: a whole rubric as JSON, overriding the defaults in one shot.
# This is config/rubric.yaml converted to JSON. Leave empty to use defaults.
# RADAR_RUBRIC_JSON={"weights":{"budget":30,"hire_rate":20}}

# ---------------------------------------------------------------------------
# Caps - see config/caps.example.yaml for what each one does
# ---------------------------------------------------------------------------

# Cap 1: units of work per execution (one step = one job scored).
RADAR_MAX_STEPS_PER_RUN=200

# Cap 2: hard stop for a single execution, in seconds.
# Keep below the workflow's executionTimeout (300).
RADAR_WALL_CLOCK_SECONDS=120

# Cap 3: rolling spend cap, persisted between runs.
# The default install spends $0.00 - this matters the moment you add an LLM node.
RADAR_SPEND_CAP_USD=5.0
RADAR_SPEND_WINDOW_HOURS=24

# Circuit breaker: consecutive failed runs before the workflow disables itself,
# and how long before it allows one half-open probe run. 0 = human reset only.
RADAR_BREAKER_CONSECUTIVE_ERRORS=3
RADAR_BREAKER_COOLDOWN_MINUTES=60

# Optional: whole caps object as JSON, overriding the above.
# RADAR_CAPS_JSON={"spend":{"cap_usd":1.0}}
